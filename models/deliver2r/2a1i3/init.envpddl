(define
    (problem 2r2a1i3)
    (:domain deliver2r)

    (:agents 
        a b
    )

    (:objects
        i - item
    )

    (:init
        (assign (agent_loc a) 1)
        (assign (agent_loc b) 1)
        (assign (holding a) 0)
        (assign (holding b) 0)
        (assign (hold_by i a) 0)
        (assign (hold_by i b) 0)
        (assign (item_loc i) 1)
        (assign (is_free i) 1)
    )

    (:ranges
        (agent_loc integer [1,2])
        (item_loc integer [1,2])
        (holding integer [0,1])
        (hold_by integer [0,1])
        (is_free integer [0,1])
    )

    (:goal_sets
        hold_by(i,a)=[all]
        hold_by(i,b)=[all]
    )

    (:max_belief_depth 2)

    (:rules
    )
)