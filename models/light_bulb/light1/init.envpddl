(define
    (problem light1)
    (:domain light_bulb)

    (:agents 
        a b c
    )

    (:objects
        l1 l2 l3 l4 - light
        b1 b2 b3 b4 - button
        on off - bs
    )

    (:init
        (assign (light_on l1) t)
        (assign (light_on l2) t)
        (assign (light_on l3) t)
        (assign (light_on l4) t)

        (assign (light_off l1) f)
        (assign (light_off l2) f)
        (assign (light_off l3) f)
        (assign (light_off l4) f)

        (assign (button_state b1) off)
        (assign (button_state b2) off)
        (assign (button_state b3) off)
        (assign (button_state b4) off)

        (assign (button_light_state b1 on) on)
        (assign (button_light_state b1 off) off)

        (assign (button_light_state b2 on) on)
        (assign (button_light_state b2 off) off)

        (assign (button_light_state b3 on) on)
        (assign (button_light_state b3 off) off)

        (assign (button_light_state b4 on) on)
        (assign (button_light_state b4 off) off)

        (assign (connected b1) l1)
        (assign (connected b2) l2)
        (assign (connected b3) l3)
        (assign (connected b4) l4)

        (assign (agent_id a) a)
        (assign (agent_id b) b)
        (assign (agent_id c) c)

        (assign (tell_lock) 0)

        (assign (telling a) 0)
        (assign (telling b) 0)
        (assign (telling c) 0)

        (assign (a_observable l1) 0)
        (assign (a_observable l2) 0)
        (assign (a_observable l3) 0)
        (assign (a_observable l4) 0)

        (assign (observable l1) b)
        (assign (observable l2) b)
        (assign (observable l3) c)
        (assign (observable l4) c)

    )

    (:ranges
        (light_on enumerate [t])
        (light_off enumerate [t])
        (button_state enumerate [on,off])
        (button_light_state enumerate [on,off])
        (connected enumerate [l1,l2,l3,l4])
        (agent_id enumerate [a,b,c])
        (tell_lock integer [0,1])
        (telling integer [0,1])
        (a_observable integer [0,1])
        (observable enumerate [b,c])
    )
    

    (:goal_sets
        b[a] light_state(all) = 1
    )

    (:max_belief_depth 1)

    (:rules
    )
)