(define
    (problem light2)
    (:domain light_bulb)

    (:agents 
        a external b c
    )

    (:objects
        l1 l2 - light
        b1 b2 - button
        on off - bs
    )

    (:init
        (assign (light_state l1) off)
        (assign (light_state l2) off)

        (assign (light_id l1) l1)
        (assign (light_id l2) l2)

        (assign (button_state b1) off)
        (assign (button_state b2) off)

        (assign (button_light_state b1 on) on)
        (assign (button_light_state b1 off) off)

        (assign (button_light_state b2 on) on)
        (assign (button_light_state b2 off) off)

        (assign (bs_id on) on)
        (assign (bs_id off) off)

        (assign (connected b1) l1)
        (assign (connected b2) l2)

        (assign (agent_id a) a)
        (assign (agent_id b) b)
        (assign (agent_id c) c)
        (assign (agent_id external) external)

        (assign (tell_lock) 0)

        (assign (telling a) 0)
        (assign (telling b) 0)
        (assign (telling c) 0)
        (assign (telling external) 0)

        (assign (a_observable l1) 0)
        (assign (a_observable l2) 0)

        (assign (observable l1) b)
        (assign (observable l2) c)

    )

    (:ranges
        (light_state enumerate [on,off])
        (light_id enumerate [l1,l2])
        (button_state enumerate [on,off])
        (button_light_state enumerate [on,off])
        (bs_id enumerate [on,off])
        (connected enumerate [l1,l2])
        (agent_id enumerate [a,b,c,external])
        (tell_lock integer [0,1])
        (telling integer [0,1])
        (a_observable integer [0,1])
        (observable enumerate [b,c])
    )
    

    (:goal_sets
        b[a] light_state(all) = on
    )

    (:max_belief_depth 1)

    (:rules
    )
)