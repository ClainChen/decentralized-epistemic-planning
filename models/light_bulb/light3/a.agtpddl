(define
    (problem light3)
    (:domain light_bulb)
    (:agent a)

    (:goal (and
        (= (@ep (" b [a]") (= (light_state l1) on)) ep.true)
        (= (@ep (" b [a]") (= (light_state l2) on)) ep.true)
        (= (@ep (" b [a]") (= (light_state l3) on)) ep.true)
        (= (@ep (" b [a]") (= (light_state l4) on)) ep.true)
        )
    )
)