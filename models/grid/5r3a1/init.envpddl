(define
    (problem 5r3a1)
    (:domain grid)

    (:agents 
        a b c
    )

    (:objects
        s1 - survivor
        r0 r1 r2 r3 r4 r5 - location
    )

    (:init
        (assign (agent_loc a) r1)
        (assign (agent_loc b) r3)
        (assign (agent_loc c) r5)

        (assign (movable a) 1)
        (assign (movable b) 1)
        (assign (movable c) 1)

        (assign (sharable a) 1)
        (assign (sharable b) 1)
        (assign (sharable c) 1)

        (assign (receivable a) 1)
        (assign (receivable b) 1)
        (assign (receivable c) 1)

        (assign (survivor_loc s1) r4)

        (assign (shared s1) 0)

        (assign (sharing a) 0)
        (assign (sharing b) 0)
        (assign (sharing c) 0)

        (assign (searched r0) 1)
        (assign (searched r1) 1)
        (assign (searched r2) 0)
        (assign (searched r3) 1)
        (assign (searched r4) 0)
        (assign (searched r5) 0)

        (assign (loc_id r0) r0)
        (assign (loc_id r1) r1)
        (assign (loc_id r2) r2)
        (assign (loc_id r3) r3)
        (assign (loc_id r4) r4)
        (assign (loc_id r5) r5)

        (assign (connected r0 r0) 0)
        (assign (connected r0 r1) 0)
        (assign (connected r0 r2) 0)
        (assign (connected r0 r3) 0)
        (assign (connected r0 r4) 0)
        (assign (connected r0 r5) 0)

        (assign (connected r1 r0) 0)
        (assign (connected r1 r1) 0)
        (assign (connected r1 r2) 1)
        (assign (connected r1 r3) 0)
        (assign (connected r1 r4) 1)
        (assign (connected r1 r5) 0)

        (assign (connected r2 r0) 0)
        (assign (connected r2 r1) 1)
        (assign (connected r2 r2) 0)
        (assign (connected r2 r3) 1)
        (assign (connected r2 r4) 1)
        (assign (connected r2 r5) 1)

        (assign (connected r3 r0) 0)
        (assign (connected r3 r1) 0)
        (assign (connected r3 r2) 1)
        (assign (connected r3 r3) 0)
        (assign (connected r3 r4) 0)
        (assign (connected r3 r5) 1)

        (assign (connected r4 r0) 0)
        (assign (connected r4 r1) 1)
        (assign (connected r4 r2) 1)
        (assign (connected r4 r3) 0)
        (assign (connected r4 r4) 0)
        (assign (connected r4 r5) 1)

        (assign (connected r5 r0) 0)
        (assign (connected r5 r1) 0)
        (assign (connected r5 r2) 1)
        (assign (connected r5 r3) 1)
        (assign (connected r5 r4) 1)
        (assign (connected r5 r5) 0)

    )

    (:ranges
        (agent_loc enumerate [r0,r1,r2,r3,r4,r5])
        (survivor_loc enumerate [r0,r1,r2,r3,r4,r5])
        (loc_id enumerate [r0,r1,r2,r3,r4,r5])
        (shared integer [0,1])
        (sharing integer [0,1])
        (connected integer [0,1])
        (sharable integer [0,1])
        (movable integer [0,1])
        (receivable integer [0,1])
        (searched integer [0,1])
    )
    

    (:goal_sets
        survivor_loc(all)=[all]
        searched(all)=[all]
    )

    (:max_belief_depth 1)

    (:rules
    )
)