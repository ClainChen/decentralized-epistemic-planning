(define
    (problem muddy2)
    (:domain muddy_children)

    (:agents 
        a b c t
    )

    (:objects

    )

    (:init
        (assign (number_of_questions) 0)

        (assign (muddy a) 0)
        (assign (muddy b) 1)
        (assign (muddy c) 1)
        (assign (muddy t) 0)

        (assign (is_type a) child)
        (assign (is_type b) child)
        (assign (is_type c) child)
        (assign (is_type t) teacher)

        (assign (shouted) 0)
    )

    (:ranges
        (number_of_questions integer [0,3])
        (is_type enumerate [child,teacher])
        (muddy integer [0,1])
        (shouted integer [0,1])
    )
    

    (:goal_sets
        muddy(a)=[all]
        muddy(b)=[all]
        muddy(c)=[all]
    )

    (:max_belief_depth 1)

    (:rules
    )
)